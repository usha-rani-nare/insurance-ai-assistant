              "path": [
                "api",
                "ai",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What does the Health Secure plan cover?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "RAG answer with sources. May take a few seconds."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask about a claim (tool call)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/ai/chat",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "ai",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the status of claim CLM1001?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Works as the demo user (Usha). The assistant calls the getClaimStatus tool, which only sees the logged-in user's claims."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
