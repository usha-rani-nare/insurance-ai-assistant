            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": {{policyId}},\n  \"claimType\": \"Accident\",\n  \"description\": \"Postman test claim\",\n  \"claimAmount\": 1500\n}",
              "options": {
