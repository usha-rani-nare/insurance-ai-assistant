# Copy this file to .env (or export these as real environment variables)
# and fill in real values. Never commit the actual .env file.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=insurance_assistant
DB_USERNAME=root
DB_PASSWORD=root

# The origin the frontend is served from during local development.
# Default (5500) matches VS Code's Live Server extension.
FRONTEND_ORIGIN=http://localhost:5500

# Groq API key for the AI assistant - get one free at console.groq.com
# Never commit your real key. GROQ_MODEL can be left as-is unless Groq
# deprecates this model (check console.groq.com/docs/models for current
# "Production" status models - Groq's free-tier lineup changes often).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL (with the pgvector extension) - stores document embeddings for
# RAG. Separate from the MySQL database above.
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5433
VECTOR_DB_NAME=insurance_vectors
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=postgres

